{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "h5scope",
  "version": "0.1.0",
  "description": "A Qt-based viewer for HDF5 files.",
  "license": "GPL-3.0-only",
  "builtin-baseline": "00c5775211f45cd08b37fce0484b4cb940e422ab",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "widgets",
        "testlib",
        "thread",
        "concurrent",
        "network",
        "freetype",
        "fontconfig",
        "harfbuzz",
        "png",
        "doubleconversion",
        "pcre2",
        "zstd",
        "opengl",
        "egl",
        "xcb",
        "xcb-xlib",
        "xcb-sm",
        "xkb",
        "xkbcommon-x11",
        "xrender",
        "xlib",
        "wayland"
      ]
    },
    "qtdeclarative",
    "qtgraphs",
    "hdf5",
    "catch2"
  ],
  "overrides": [
    {
      "name": "hdf5",
      "version-semver": "2.2.0"
    }
  ]
}
