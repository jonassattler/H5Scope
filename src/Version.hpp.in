#pragma once

// Generated by CMake from src/Version.hpp.in -- do not edit, and do not commit
// the generated copy. The numbers come from cmake/Version.cmake, which counts
// the release tags rather than being told a version.

namespace h5scope {

/// "0.2.1" on a release, "0.2.1-dev" on the way to one, or
/// "0.2.0 (unversioned build)" where there were no tags to count. What the
/// application reports about itself.
inline constexpr const char* kVersion = "@H5SCOPE_VERSION_STRING@";
/// The same without the qualifier: three numbers, always parseable.
inline constexpr const char* kVersionNumber = "@H5SCOPE_VERSION@";
/// The commit this was built from, short, or "unknown".
inline constexpr const char* kCommit = "@H5SCOPE_COMMIT@";

} // namespace h5scope
