build/
# Where tools/make-appimage.sh writes, and where CI picks the AppImage up.
dist/
CMakeUserPresets.json
compile_commands.json
vcpkg_installed/
.cache/

# Generated by tools/make-example-file; never committed as binaries.
examples/

# Scratch notes, not the project's own. Kept out so a `git add -A` cannot
# sweep them in, which is how issues.txt got committed once.
issues.txt

# Working notes, design documents and the development log. Kept on disk and
# out of the repository: they are how the thing got built, not what it is, and
# a public release should not have to explain them.
instructions/

# Agent configuration, local to this checkout.
.claude/
